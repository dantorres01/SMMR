/* ----------------------- Algoritmo -----------------------*/

/* Función de conversión ADC - Fuerzas G*/ 
static void convert_accel(
    imu_state_t *imu,
    int16_t ax,
    int16_t ay,
    int16_t az)
{
    imu->ax = ((float)ax / ACC_SCALE_2G) * G;
    imu->ay = ((float)ay / ACC_SCALE_2G) * G;
    imu->az = ((float)az / ACC_SCALE_2G) * G;
}

/* Tarea de adquisición */
void task_motion(void *pvParameters)
{
    uint64_t last_timestamp =
        esp_timer_get_time();

    imu_state_t imu = {0};

    int16_t ax;
    int16_t ay;
    int16_t az;

    /*
       Mantiene el periodo de adquisición
       respecto a una referencia temporal fija.
    */
    TickType_t last_wake_time =
        xTaskGetTickCount();


    while(1)
    {
        if(bmi160_read_accel(
            &ax,
            &ay,
            &az) == ESP_OK)
        {
            convert_accel(
                &imu,
                ax,
                ay,
                az
            );

            remove_offset(&imu);
            remove_gravity(&imu);

            /*
               low_pass_filter().
            */

            uint64_t now =
                esp_timer_get_time();

            imu.dt =
                (now - last_timestamp)
                / 1000000.0f;

            last_timestamp = now;

            imu.timestamp = now;

            if(head < WINDOW_SIZE)
            {
                /*
                   UNA muestra leída =
                   UNA posición del buffer.
                */

                fill_buffer[head] = imu;

                head++;
            }

            if(head >= WINDOW_SIZE)
            {
                if(!proceesing_busy)
                {
                    imu_state_t *temp = process_buffer;

                    process_buffer = fill_buffer;

                    fill_buffer = temp;

                    features.timestamp =
                        process_buffer[
                            WINDOW_SIZE - 1
                        ].timestamp;

                    head = 0;

                    processing_request =
                        true;
                }
            }
        }

        vTaskDelayUntil(
            &last_wake_time,
            pdMS_TO_TICKS(
                SAMPLE_PERIOD_MS
            )
        );
    }
}

/* Funciones de Preprocesamiento */
static void calculate_offset(void){
    int16_t ax, ay, az;
    
    float sum_x = 0.0f;
    float sum_y = 0.0f;
    float sum_z = 0.0f;

    imu_state_t imu;

    printf("Calculando offset...\n");

    for(int i = 0; i < 1000; i++){
        if(bmi160_read_accel(&ax, &ay, &az) == ESP_OK){
            convert_accel(&imu, ax, ay, az);

            sum_x += imu.ax;
            sum_y += imu.ay;
            sum_z += imu.az;
        }

        vTaskDelay(pdMS_TO_TICKS(2));
    }

    offset_x = sum_x / 1000.0f;
    offset_y = sum_y / 1000.0f;
    offset_z = sum_z / 1000.0f;

    printf("Offset:\n");
    printf("X = %.5f\n", offset_x);
    printf("Y = %.5f\n", offset_y);
    printf("Z = %.5f\n", offset_z);
}

static void remove_offset(imu_state_t *imu){
    imu->ax -= offset_x;
    imu->ay -= offset_y;
    imu->az -= offset_z;
}

static void remove_gravity(imu_state_t *imu){
    /* Tecnicas con giroscopio a desarrollar */
}

