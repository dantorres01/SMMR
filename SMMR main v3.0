static void reset_baseline_learning(void)
{
    baseline_stability_counter = 0;

    baseline_accumulator.count = 0;

    for(int i = 0; i < 3; i++)
    {
        baseline_accumulator.rms_sum[i] = 0.0f;
        baseline_accumulator.peak_sum[i] = 0.0f;
    }

    baseline_accumulator.amp_1x_sum = 0.0f;
    baseline_accumulator.amp_2x_sum = 0.0f;
    baseline_accumulator.amp_3x_sum = 0.0f;
}

static void update_baseline(void)
{
    /*=========================================
      1. Periodo de estabilización
    =========================================*/

    if(baseline_stability_counter <
       BASELINE_STABILIZATION_WINDOWS)
    {
        baseline_stability_counter++;

        printf(
            "Baseline: stabilizing (%u/%u)\n",
            baseline_stability_counter,
            BASELINE_STABILIZATION_WINDOWS
        );

        return;
    }


    /*=========================================
      2. Acumular ventana
    =========================================*/

    for(int i = 0; i < 3; i++)
    {
        baseline_accumulator.rms_sum[i] +=
            features.rms[i];

        baseline_accumulator.peak_sum[i] +=
            features.peak[i];
    }

    baseline_accumulator.amp_1x_sum +=
        features.order_amp_1x;

    baseline_accumulator.amp_2x_sum +=
        features.order_amp_2x;

    baseline_accumulator.amp_3x_sum +=
        features.order_amp_3x;


    baseline_accumulator.count++;


    printf(
        "Baseline: learning (%u/%u)\n",
        baseline_accumulator.count,
        BASELINE_WINDOWS
    );


    /*=========================================
      3. ¿Ya tenemos cinco ventanas?
    =========================================*/

    if(baseline_accumulator.count <
       BASELINE_WINDOWS)
    {
        return;
    }


    /*=========================================
      4. Calcular promedio
    =========================================*/

    for(int i = 0; i < 3; i++)
    {
        baseline.rms[i] =
            baseline_accumulator.rms_sum[i] /
            BASELINE_WINDOWS;

        baseline.peak[i] =
            baseline_accumulator.peak_sum[i] /
            BASELINE_WINDOWS;
    }


    baseline.amp_1x =
        baseline_accumulator.amp_1x_sum /
        BASELINE_WINDOWS;

    baseline.amp_2x =
        baseline_accumulator.amp_2x_sum /
        BASELINE_WINDOWS;

    baseline.amp_3x =
        baseline_accumulator.amp_3x_sum /
        BASELINE_WINDOWS;


    /*=========================================
      5. Activar baseline
    =========================================*/

    baseline.valid = true;


    printf("\n");
    printf("====================================\n");
    printf(" BASELINE COMPLETED\n");
    printf("====================================\n");

    printf(
        "RMS  : X=%.5f Y=%.5f Z=%.5f\n",
        baseline.rms[0],
        baseline.rms[1],
        baseline.rms[2]
    );

    printf(
        "Peak : X=%.5f Y=%.5f Z=%.5f\n",
        baseline.peak[0],
        baseline.peak[1],
        baseline.peak[2]
    );

    printf(
        "1X   : %.3f\n",
        baseline.amp_1x
    );

    printf(
        "2X   : %.3f\n",
        baseline.amp_2x
    );

    printf(
        "3X   : %.3f\n",
        baseline.amp_3x
    );

    printf("====================================\n");
}

static float baseline_max_rms(void)
{
    float max_rms = baseline.rms[0];

    for(int i = 1; i < 3; i++)
    {
        if(baseline.rms[i] > max_rms)
        {
            max_rms = baseline.rms[i];
        }
    }

    return max_rms;
}

/* Tenicas de procesamiento digital de señales */
static void calculate_rms(void)
{
    float sum_x = 0.0f;
    float sum_y = 0.0f;
    float sum_z = 0.0f;

    for(uint16_t i = 0; i < WINDOW_SIZE; i++)
    {
        float ax = process_buffer[i].ax;
        float ay = process_buffer[i].ay;
        float az = process_buffer[i].az;
        
        sum_x += ax * ax;
        sum_y += ay * ay;
        sum_z += az * az;
    }

    rms_x = sqrtf(sum_x / WINDOW_SIZE);
    rms_y = sqrtf(sum_y / WINDOW_SIZE);
    rms_z = sqrtf(sum_z / WINDOW_SIZE);

    features.rms[0] = rms_x;
    features.rms[1] = rms_y;
    features.rms[2] = rms_z;
}

static void calculate_peak(void)
{
    peak_x = 0;
    peak_y = 0;
    peak_z = 0;

    for(uint16_t i = 0; i < WINDOW_SIZE; i++)
    {
        float ax = fabsf(process_buffer[i].ax);
        float ay = fabsf(process_buffer[i].ay);
        float az = fabsf(process_buffer[i].az);


        if(ax > peak_x)
            peak_x = ax;

        if(ay > peak_y)
            peak_y = ay;

        if(az > peak_z)
            peak_z = az;
    }

    features.peak[0] = peak_x;
    features.peak[1] = peak_y;
    features.peak[2] = peak_z;
}

static void calculate_crest_factor(void)
{
    if(rms_x > 0.000001f)
    {
        crest_x = peak_x / rms_x;
    }
    else
    {
        crest_x = 0.0f;
    }

    if(rms_y > 0.000001f)
    {
        crest_y = peak_y / rms_y;
    }
    else
    {
        crest_y = 0.0f;
    }

    if(rms_z > 0.000001f)
    {
        crest_z = peak_z / rms_z;
    }
    else
    {
        crest_z = 0.0f;
    }

    features.crest[0] = crest_x;
    features.crest[1] = crest_y;
    features.crest[2] = crest_z;
}

static void calculate_kurtosis(void)
{
    float sum_x = 0.0f;
    float sum_y = 0.0f;
    float sum_z = 0.0f;

    if(rms_x < 1e-6f || rms_y < 1e-6f || rms_z < 1e-6f)
    {
        kurtosis_x = 0;
        kurtosis_y = 0;
        kurtosis_z = 0;

        return;
    }

    for(uint16_t i = 0; i < WINDOW_SIZE; i++)
    {
        float x = process_buffer[i].ax / rms_x;
        float y = process_buffer[i].ay / rms_y;
        float z = process_buffer[i].az / rms_z;

        sum_x += x*x*x*x;
        sum_y += y*y*y*y;
        sum_z += z*z*z*z;
    }

    kurtosis_x = sum_x / WINDOW_SIZE;   
    kurtosis_y = sum_y / WINDOW_SIZE;
    kurtosis_z = sum_z / WINDOW_SIZE;

    features.kurtosis[0] = kurtosis_x;
    features.kurtosis[1] = kurtosis_y;
    features.kurtosis[2] = kurtosis_z;
}

static void calculate_hann_window(void)
{
    fft_window_sum = 0.0f;

    for(int i = 0; i < FFT_SIZE; i++)
    {
        fft_window[i] =
            0.5f *
            (1.0f -
             cosf(
                 (2.0f * M_PI * i) /
                 (FFT_SIZE - 1)
             ));

        fft_window_sum += fft_window[i];
    }
}

static void find_fft_peaks(
    float *fft_mag,
    float *peak_freq,
    float *peak_amp)
{
    for(int i = 0; i < FFT_TOP_PEAKS; i++)
    {
        peak_freq[i] = 0.0f;
        peak_amp[i] = 0.0f;
    }

    for(int i = 2; i < FFT_SIZE/2 - 2; i++)
    {
        /* Buscar máximos locales */
        if(fft_mag[i] > fft_mag[i-1] &&
           fft_mag[i] > fft_mag[i+1])
        {
            bool separated = true;

            /* Comprobar distancia mínima */
            for(int k = 0; k < FFT_TOP_PEAKS; k++)
            {
                if(peak_freq[k] != 0.0f)
                {
                    float old_bin =
                        peak_freq[k] * FFT_SIZE / SAMPLE_RATE_HZ;

                    if(fabsf((float)i - old_bin) < MIN_PEAK_DISTANCE)
                    {
                        separated = false;
                        break;
                    }
                }
            }

            if(!separated)
                continue;

            float amp = fft_mag[i];
            float freq =
                ((float)i * SAMPLE_RATE_HZ) / FFT_SIZE;

            /* Insertar ordenado */
            for(int k = 0; k < FFT_TOP_PEAKS; k++)
            {
                if(amp > peak_amp[k])
                {
                    for(int j = FFT_TOP_PEAKS-1; j > k; j--)
                    {
                        peak_amp[j] = peak_amp[j-1];
                        peak_freq[j] = peak_freq[j-1];
                    }

                    peak_amp[k] = amp;
                    peak_freq[k] = freq;

                    break;
                }
            }
        }
    }
}

static void process_fft_axis(
    float *input,
    float *fft_buffer,
    float *fft_mag,
    float *peak_freq,
    float *peak_amp)
{

    for(int i = 0; i < FFT_SIZE; i++)
    {
        fft_buffer[2*i] =
            input[i] * fft_window[i];

        fft_buffer[2*i+1] = 0.0f;
    }


    dsps_fft2r_fc32(
        fft_buffer,
        FFT_SIZE
    );

    dsps_bit_rev_fc32(
        fft_buffer,
        FFT_SIZE
    );

    dsps_cplx2reC_fc32(
        fft_buffer,
        FFT_SIZE
    );


    for(int i = 0; i < FFT_SIZE/2; i++)
    {
        float real = fft_buffer[2*i];
        float imag = fft_buffer[2*i+1];

        float magnitude = sqrtf(real * real + imag * imag);

        /* Normalización de amplitud para
        espectro unilateral con ventana Hann. */
        
        if(i == 0)
        {
            fft_mag[i] = magnitude / fft_window_sum;
        }
        else
        {
            fft_mag[i] = (2.0f * magnitude) / fft_window_sum;
        }
    }

    find_fft_peaks(fft_mag, peak_freq, peak_amp);
}

static void calculate_fft(void)
{
    static float input_x[FFT_SIZE];
    static float input_y[FFT_SIZE];
    static float input_z[FFT_SIZE];

    for(int i = 0; i < FFT_SIZE; i++)
    {
        input_x[i] = process_buffer[i].ax;
        input_y[i] = process_buffer[i].ay;
        input_z[i] = process_buffer[i].az;
    }

    process_fft_axis(
        input_x,
        fft_buffer_x,
        fft_mag_x,
        fft_peak_freq_x,
        fft_peak_amp_x);

    process_fft_axis(
        input_y,
        fft_buffer_y,
        fft_mag_y,
        fft_peak_freq_y,
        fft_peak_amp_y);

    process_fft_axis(
        input_z,
        fft_buffer_z,
        fft_mag_z,
        fft_peak_freq_z,
        fft_peak_amp_z);

    for(int i = 0; i < FFT_TOP_PEAKS; i++)
    {
        features.fft_freq[0][i] = fft_peak_freq_x[i];
        features.fft_amp [0][i] = fft_peak_amp_x[i];
        
        features.fft_freq[1][i] = fft_peak_freq_y[i];
        features.fft_amp [1][i] = fft_peak_amp_y[i];
        
        features.fft_freq[2][i] = fft_peak_freq_z[i];
        features.fft_amp [2][i] = fft_peak_amp_z[i];

    }

    float best_amp = 0.0f;
    features.dominant_axis = 0;

    for (int axis = 0; axis < 3; axis++)
    {
        if(features.fft_amp[axis][0] > best_amp)
        {
            best_amp = features.fft_amp[axis][0];

            features.dominant_amp = features.fft_amp[axis][0];
            features.dominant_freq = features.fft_freq[axis][0];
            features.dominant_axis = axis;
        }
    }

    if(shaft_frequency > 0.0f)
    {
        features.dominant_order = features.dominant_freq / shaft_frequency;
    }
    else
    {
        features.dominant_order = 0.0f;
    }

    features.order_amp_1x = order_amplitude(1.0f, 0.15f);
    features.order_amp_2x = order_amplitude(2.0f, 0.15f);
    features.order_amp_3x = order_amplitude(3.0f, 0.20f);
    features.order_amp_4x = order_amplitude(4.0f, 0.20f);

    if(features.order_amp_1x > 0.001f)
    {
        features.order_ratio_2x_1x =
        features.order_amp_2x /
        features.order_amp_1x;

    features.order_ratio_3x_1x =
        features.order_amp_3x /
        features.order_amp_1x;

    features.order_ratio_4x_1x =
        features.order_amp_4x /
        features.order_amp_1x;
    }
    else
    {
        features.order_ratio_2x_1x = 0;
        features.order_ratio_3x_1x = 0;
        features.order_ratio_4x_1x = 0;
    }
}

/* Configuración de datos de máquina */
static void load_machine_configuration(void)
{
    /*=========================================
      MGM Motori Elettrici BM 63 B4
    =========================================*/

    machine.manufacturer = "M.G.M. Motori Elettrici";
    machine.model = "BM 63 B4";

    /* Motor de cuatro polos */
    machine.poles = 4;

    /* Datos nominales */
    machine.rated_frequency_hz = 50.0f;
    machine.rated_rpm = 1350.0f;
    machine.rated_power_kw = 0.18f;

    /* Condiciones de alimentación actuales */
    machine.supply_frequency_hz = 60.0f;
    machine.supply_voltage_v = 220.0f;


    /*=========================================
      Velocidad síncrona
    =========================================*/

    machine.synchronous_rpm =
        (120.0f * machine.supply_frequency_hz) /
        (float)machine.poles;


    /*=========================================
      Velocidad utilizada para Order Tracking
    =========================================*/

    /*
       Estimación inicial.

       Motor 4 polos + 60 Hz:
       velocidad síncrona = 1800 RPM.

       Las pruebas anteriores mostraron una
       componente dominante de ~29.9 Hz,
       equivalente a ~1794 RPM.

       Hasta medir con tacómetro se utiliza
       1800 RPM como referencia estimada.
    */

    machine.operating_rpm = 1800.0f;

    machine.rpm_measured = false;


    /* Frecuencia mecánica */

    machine.shaft_frequency_hz =
        machine.operating_rpm / 60.0f;


    /* Variables utilizadas actualmente
       por el resto del algoritmo */

    machine_rpm =
        machine.operating_rpm;

    shaft_frequency =
        machine.shaft_frequency_hz;


    /*=========================================
      Reporte
    =========================================*/

    printf("\n");
    printf("====================================\n");
    printf(" Configuracion de la maquina\n");
    printf("====================================\n");

    printf("Fabricante             : %s\n",
           machine.manufacturer);

    printf("Modelo                 : %s\n",
           machine.model);

    printf("Polos                  : %u\n",
           machine.poles);

    printf("Potencia nominal       : %.2f kW\n",
           machine.rated_power_kw);

    printf("Frecuencia nominal     : %.1f Hz\n",
           machine.rated_frequency_hz);

    printf("RPM nominales (50 Hz)  : %.1f RPM\n",
           machine.rated_rpm);

    printf("Alimentacion           : %.0f V / %.1f Hz\n",
           machine.supply_voltage_v,
           machine.supply_frequency_hz);

    printf("RPM sincronas (60 Hz)  : %.1f RPM\n",
           machine.synchronous_rpm);

    printf("RPM usadas en analisis : %.1f RPM %s\n",
           machine.operating_rpm,
           machine.rpm_measured ?
           "(MEDIDAS)" :
           "(ESTIMADAS)");

    printf("Frecuencia de giro     : %.2f Hz\n",
           machine.shaft_frequency_hz);

    printf("====================================\n");
    printf("\n");
}

static bool order_is_observable(float order)
{
    if(shaft_frequency <= 0.0f)
        return false;

    float frequency =
        shaft_frequency * order;

    float nyquist =
        SAMPLE_RATE_HZ / 2.0f;

    /*
       Dejamos un pequeño margen respecto
       a Nyquist.
    */

    return frequency < (nyquist * 0.95f);
}

static float order_amplitude(
    float target_order,
    float tolerance)
{
    if(shaft_frequency <= 0.0f)
        return 0.0f;


    float target_frequency =
        shaft_frequency * target_order;


    /*=========================================
      Comprobar Nyquist
    =========================================*/

    float nyquist_frequency =
        SAMPLE_RATE_HZ / 2.0f;


    if(target_frequency >= nyquist_frequency)
    {
        /*
           Esa orden no puede medirse con
           la frecuencia de muestreo actual.
        */

        return 0.0f;
    }


    float best_amp = 0.0f;


    /*=========================================
      Buscar directamente en todo el espectro
    =========================================*/

    for(int axis = 0; axis < 3; axis++)
    {
        float *spectrum = NULL;

        switch(axis)
        {
            case 0:
                spectrum = fft_mag_x;
                break;

            case 1:
                spectrum = fft_mag_y;
                break;

            case 2:
                spectrum = fft_mag_z;
                break;
        }


        for(int bin = 1;
            bin < FFT_SIZE / 2;
            bin++)
        {
            float frequency =
                ((float)bin *
                 SAMPLE_RATE_HZ) /
                FFT_SIZE;


            float order =
                frequency /
                shaft_frequency;


            if(fabsf(order - target_order)
               <= tolerance)
            {
                if(spectrum[bin] > best_amp)
                {
                    best_amp =
                        spectrum[bin];
                }
            }
        }
    }


    return best_amp;
}

static int eval_normal(
    float max_rms,
    float max_peak,
    float max_crest,
    float max_kurtosis)
{
    int points = 0;


    if(!baseline.valid)
    {
        return 0;
    }


    float baseline_rms =
        baseline_max_rms();


    if(baseline_rms <= 0.000001f)
    {
        return 0;
    }


    float rms_ratio =
        max_rms /
        baseline_rms;

    float ratio_1x =
        features.order_amp_1x /
        baseline.amp_1x;


    /*
       RMS próximo al baseline.
    */

    if(rms_ratio >=
           (1.0f - BASELINE_NORMAL_TOLERANCE) &&
       rms_ratio <=
           (1.0f + BASELINE_NORMAL_TOLERANCE))
    {
        points += 3;
    }


    /*
       1X próximo a la firma sana.
    */

    if(ratio_1x >=
           (1.0f - BASELINE_NORMAL_TOLERANCE) &&
       ratio_1x <=
           (1.0f + BASELINE_NORMAL_TOLERANCE))
    {
        points += 3;
    }


    /*
       Firma poco impulsiva.
    */

    if(max_crest < 4.0f)
    {
        points += 1;
    }


    if(max_kurtosis < 3.5f)
    {
        points += 1;
    }


    return points;
}

static int eval_unbalance(
    float max_rms,
    float max_peak,
    float max_crest,
    float max_kurtosis)
{
    int points = 0;


    if(!baseline.valid)
    {
        return 0;
    }


    if(!order_is_observable(1.0f))
    {
        return 0;
    }


    if(features.order_amp_1x <= 0.001f ||
       baseline.amp_1x <= 0.001f)
    {
        return 0;
    }


    float baseline_rms =
        baseline_max_rms();

    if(baseline_rms <= 0.000001f)
    {
        return 0;
    }


    float rms_ratio =
        max_rms /
        baseline_rms;

    float amp_1x_ratio =
        features.order_amp_1x /
        baseline.amp_1x;


    /*
       1X debe seguir siendo dominante.
    */

    if(fabsf(
           features.dominant_order - 1.0f
       ) <= UNBALANCE_ORDER_TOLERANCE)
    {
        points += 2;
    }


    /*
       Evidencia principal:
       aumento real de 1X respecto al motor sano.
    */

    if(amp_1x_ratio >
       UNBALANCE_1X_INCREASE)
    {
        points += 4;
    }


    /*
       RMS global también aumenta.
    */

    if(rms_ratio >
       UNBALANCE_RMS_INCREASE)
    {
        points += 2;
    }


    /*
       El desbalance normalmente conserva
       una señal periódica y poco impulsiva.
    */

    if(features.order_ratio_2x_1x < 0.20f && features.order_ratio_3x_1x < 0.10f)
    {
        points += 1;
    }

    return points;
}

static int eval_misalignment(
    float max_rms)
{
    int points = 0;

    if(!baseline.valid)
        return 0;

    if(!order_is_observable(2.0f))
        return 0;

    if(features.order_amp_1x <= 0.001f ||
       baseline.amp_2x <= 0.001f)
    {
        return 0;
    }


    float ratio_2x_1x =
        features.order_ratio_2x_1x;

    float growth_2x =
        features.order_amp_2x /
        baseline.amp_2x;


    /*
       Evidencia de desalineación:
       2X debe crecer respecto al baseline
       Y además ser relevante frente a 1X.
    */

    if(growth_2x >
           MISALIGN_2X_BASELINE_INCREASE &&
       ratio_2x_1x >
           MISALIGN_2X_1X_RATIO)
    {
        points += 5;
    }


    /*
       Evidencia severa:
       2X igual o superior a 1X.
    */

    if(ratio_2x_1x >
       MISALIGN_SEVERE_RATIO)
    {
        points += 2;
    }


    return points;
}

static int eval_looseness(
    float max_rms)
{
    int points = 0;

    if(!baseline.valid)
        return 0;

    if(features.order_amp_1x <= 0.001f)
        return 0;


    bool harmonic_2x = false;
    bool harmonic_3x = false;
    bool harmonic_4x = false;


    /*=========================================
      2X
    =========================================*/

    if(order_is_observable(2.0f) &&
       baseline.amp_2x > 0.001f)
    {
        float growth_2x =
            features.order_amp_2x /
            baseline.amp_2x;

        /*
           Debe crecer respecto al baseline
           Y ser significativo respecto a 1X.
        */

        if(growth_2x >
               LOOSENESS_2X_BASELINE_INCREASE &&
           features.order_ratio_2x_1x >
               LOOSENESS_2X_1X_RATIO)
        {
            harmonic_2x = true;
            points += 2;
        }
    }


    /*=========================================
      3X
    =========================================*/

    if(order_is_observable(3.0f) &&
       baseline.amp_3x > 0.001f)
    {
        float growth_3x =
            features.order_amp_3x /
            baseline.amp_3x;

        /*
           Igual que 2X:
           crecimiento + importancia relativa.
        */

        if(growth_3x >
               LOOSENESS_3X_BASELINE_INCREASE &&
           features.order_ratio_3x_1x >
               LOOSENESS_3X_1X_RATIO)
        {
            harmonic_3x = true;
            points += 3;
        }
    }


    /*=========================================
      4X
    =========================================*/

    /*
       Con Fs = 200 Hz y shaft ≈ 30 Hz:

       4X ≈ 120 Hz > Nyquist

       Normalmente no será observable,
       pero conservamos la lógica para
       futuras configuraciones.
    */

    if(order_is_observable(4.0f))
    {
        if(features.order_ratio_4x_1x >
           LOOSENESS_4X_1X_RATIO)
        {
            harmonic_4x = true;
            points += 2;
        }
    }


    /*=========================================
      Evidencia combinada
    =========================================*/

    if(harmonic_2x &&
       harmonic_3x)
    {
        points += 3;
    }

    if(harmonic_3x &&
       harmonic_4x)
    {
        points += 1;
    }


    return points;
}

static int eval_bearing(
    float max_rms,
    float max_peak,
    float max_crest,
    float max_kurtosis)
{
    int points = 0;


    /*
       Evitar interpretar ruido de reposo
       como una falla de rodamiento.
    */

    if(max_rms < DIAG_MIN_RMS)
        return 0;


    if(max_crest > 5.5f)
        points += 3;


    if(max_kurtosis > 5.0f)
        points += 3;


    if(max_crest > 5.5f &&
       max_kurtosis > 5.0f &&
       max_peak > 0.10f)
    {
        points += 1;
    }


    return points;
}

static int eval_shock(
    float max_peak,
    float max_crest,
    float max_kurtosis)
{
    int points = 0;


    if(max_crest > 8.0f &&
       max_kurtosis > 8.0f)
    {
        points += 8;


        if(max_peak > 0.20f)
            points += 2;
    }


    return points;
}

static bool machine_activity_detected(void)
{
    float max_rms = features.rms[0];

    for(int i = 1; i < 3; i++)
    {
        if(features.rms[i] > max_rms)
        {
            max_rms = features.rms[i];
        }
    }

    bool rms_activity = max_rms > RUNNING_RMS_THRESHOLD;

    bool rotation_activity = features.order_amp_1x > RUNNING_1X_THRESHOLD;
    
    return rms_activity && rotation_activity;
}

static void update_machine_run_state(void)
{
    static uint8_t running_counter = 0;
    static uint8_t stopped_counter = 0;

    bool activity =
        machine_activity_detected();


    /*=========================================
      Actualmente STOPPED
    =========================================*/

    if(machine_run_state == MACHINE_STOPPED)
    {
        stopped_counter = 0;


        if(activity)
        {
            if(running_counter <
               RUNNING_CONFIRM_WINDOWS)
            {
                running_counter++;
            }


            if(running_counter >=
               RUNNING_CONFIRM_WINDOWS)
            {
                machine_run_state =
                    MACHINE_RUNNING;

                running_counter = 0;


                printf(
                    "\n"
                    "Machine operational state "
                    "-> RUNNING\n"
                );
            }
        }
        else
        {
            /*
               Las ventanas deben ser
               consecutivas.
            */

            running_counter = 0;
        }
    }


    /*=========================================
      Actualmente RUNNING
    =========================================*/

    else
    {
        running_counter = 0;


        if(!activity)
        {
            if(stopped_counter <
               STOPPED_CONFIRM_WINDOWS)
            {
                stopped_counter++;
            }


            if(stopped_counter >=
               STOPPED_CONFIRM_WINDOWS)
            {
                machine_run_state =
                    MACHINE_STOPPED;

                stopped_counter = 0;


                printf(
                    "\n"
                    "Machine operational state "
                    "-> STOPPED\n"
                );
            }
        }
        else
        {
            /*
               Las ventanas sin actividad
               deben ser consecutivas.
            */

            stopped_counter = 0;
        }
    }
}

static void diagnose_machine(void)
{
    /*=========================================
      1. Obtener valores máximos
    =========================================*/

    float max_rms =
        features.rms[0];

    float max_peak =
        features.peak[0];

    float max_crest =
        features.crest[0];

    float max_kurtosis =
        features.kurtosis[0];


    for(int i = 1; i < 3; i++)
    {
        if(features.rms[i] > max_rms)
            max_rms =
                features.rms[i];


        if(features.peak[i] > max_peak)
            max_peak =
                features.peak[i];


        if(features.crest[i] > max_crest)
            max_crest =
                features.crest[i];


        if(features.kurtosis[i] >
           max_kurtosis)
        {
            max_kurtosis =
                features.kurtosis[i];
        }
    }


    /*=========================================
      2. Evaluar cada estado
    =========================================*/

    score.normal =
        eval_normal(
            max_rms,
            max_peak,
            max_crest,
            max_kurtosis
        );


    score.unbalance =
        eval_unbalance(
            max_rms,
            max_peak,
            max_crest,
            max_kurtosis
        );


    score.misalignment =
        eval_misalignment(
            max_rms
        );


    score.looseness =
        eval_looseness(
            max_rms
        );


    score.bearing =
        eval_bearing(
            max_rms,
            max_peak,
            max_crest,
            max_kurtosis
        );


    score.shock =
        eval_shock(
            max_peak,
            max_crest,
            max_kurtosis
        );


    /*=========================================
      3. Seleccionar mejor diagnóstico
    =========================================*/

    int best_score =
        score.normal;

    detected_state =
        MACHINE_NORMAL;


    if(score.unbalance > best_score)
    {
        best_score =
            score.unbalance;

        detected_state =
            MACHINE_UNBALANCE;
    }


    if(score.misalignment > best_score)
    {
        best_score =
            score.misalignment;

        detected_state =
            MACHINE_MISALINGMENT;
    }


    if(score.looseness > best_score)
    {
        best_score =
            score.looseness;

        detected_state =
            MACHINE_LOOSENESS;
    }


    if(score.bearing > best_score)
    {
        best_score =
            score.bearing;

        detected_state =
            MACHINE_BEARING_DAMAGE;
    }


    if(score.shock > best_score)
    {
        best_score =
            score.shock;

        detected_state =
            MACHINE_SHOCK;
    }


    /*=========================================
      4. Guardar puntuaciones
    =========================================*/

    features.score_normal =
        score.normal;

    features.score_unbalance =
        score.unbalance;

    features.score_misalignment =
        score.misalignment;

    features.score_looseness =
        score.looseness;

    features.score_bearing =
        score.bearing;

    features.score_shock =
        score.shock;


    /*=========================================
      5. Confianza relativa
    =========================================*/

    int total =
        score.normal +
        score.unbalance +
        score.misalignment +
        score.looseness +
        score.bearing +
        score.shock;


    if(total > 0)
    {
        features.diagnosis_confidence =
            (100.0f * best_score) /
            total;
    }
    else
    {
        features.diagnosis_confidence =
            0.0f;
    }


    /*=========================================
      6. Histéresis temporal
    =========================================*/

    /*
       SHOCK es instantáneo:
       no esperar tres ventanas.
    */

    if(detected_state ==
       MACHINE_SHOCK)
    {
        current_state =
            MACHINE_SHOCK;

        candidate_state =
            MACHINE_SHOCK;

        candidate_counter = 3;
    }
    else
    {
        if(detected_state !=
           candidate_state)
        {
            candidate_state =
                detected_state;

            candidate_counter = 1;
        }
        else
        {
            if(candidate_counter < 3)
                candidate_counter++;
        }


        if(candidate_counter >= 3)
        {
            current_state =
                candidate_state;
        }
    }


    machine_state =
        current_state;


    /*=========================================
      7. Nivel de alarma
    =========================================*/

    switch(machine_state)
    {
        case MACHINE_NORMAL:

            alarm_level =
                LEVEL_NORMAL;

            break;


        case MACHINE_UNBALANCE:

        case MACHINE_MISALINGMENT:

        case MACHINE_LOOSENESS:

            alarm_level =
                LEVEL_WARNING;

            break;


        case MACHINE_BEARING_DAMAGE:

            alarm_level =
                LEVEL_ALARM;

            break;


        case MACHINE_SHOCK:

            alarm_level =
                LEVEL_CRITICAL;

            break;


        default:

            alarm_level =
                LEVEL_WARNING;

            break;
    }
}

static const char *state_to_string(machine_state_t state)
{
    switch(state)
    {
        case MACHINE_NORMAL:
            return "NORMAL";

        case MACHINE_UNBALANCE:
            return "UNBALANCE";

        case MACHINE_MISALINGMENT:
            return "MISALIGNMENT";

        case MACHINE_LOOSENESS:
            return "LOOSENESS";

        case MACHINE_BEARING_DAMAGE:
            return "BEARING DAMAGE";

        case MACHINE_SHOCK:
            return "SHOCK";

        default:
            return "UNKNOWN";
    }
}

static const char *alarm_to_string(alarm_level_t alarm)
{
    switch(alarm)
    {
        case LEVEL_NORMAL:
            return "NORMAL";

        case LEVEL_WARNING:
            return "WARNING";

        case LEVEL_ALARM:
            return "ALARM";

        case LEVEL_CRITICAL:
            return "CRITICAL";

        default:
            return "UNKNOWN";
    }
}

/* Tarea de procesamiento digital de señales */
void task_processing(void *pvParameters)
{
    while(1)
    {
        switch(dsp_state)
        {
            /* Caso de inicio */
            case DSP_IDLE: 
            if(processing_request)
            {
                processing_request = false;
                proceesing_busy = true;
                dsp_state = DSP_PREPARE;    
            }
            
            break;

            /* Caso de preparación */
            case DSP_PREPARE:

            dsp_state = DSP_RMS;
            break;

            /* Caso RMS */
            case DSP_RMS:
            
            calculate_rms();
            dsp_state = DSP_PEAK;
            break;

            /* Caso Peak */
            case DSP_PEAK:

            calculate_peak();
            dsp_state = DSP_CRESTFACTOR;
            break;

            /* Caso Crest Factor */
            case DSP_CRESTFACTOR:

            calculate_crest_factor();
            dsp_state = DSP_KURTOSIS;
            break;

            /* Caso Kurtosis */
            case DSP_KURTOSIS:

            calculate_kurtosis();
            dsp_state = DSP_FFT;
            break;

            /* Caso FFT */
            case DSP_FFT:

            calculate_fft();
            dsp_state = DSP_DIAGNOSIS;
            break;

            /* Diagnostico */
            case DSP_DIAGNOSIS:
            {
                /*
                Actividad correspondiente exclusivamente a la ventana actual.*/
                
                bool activity = machine_activity_detected();
                
                /* Actualizar estado confirmado STOPPED / RUNNING*/
                
                update_machine_run_state();
                
                /*=========================================
                Máquina sin actividad en esta ventana
                =========================================*/
                
                if(!activity)
                {
                    
                    /*
                    Si estábamos aprendiendo baseline
                    y la máquina se detuvo, descartar
                    aprendizaje incompleto.
                    */
                   
                    if(!baseline.valid)
                    {
                        reset_baseline_learning();
                    }
                    
                    score.normal = 0;
                    score.unbalance = 0;
                    score.misalignment = 0;
                    score.looseness = 0;
                    score.bearing = 0;
                    score.shock = 0;
                    
                    features.score_normal = 0;
                    features.score_unbalance = 0;
                    features.score_misalignment = 0;
                    features.score_looseness = 0;
                    features.score_bearing = 0;
                    features.score_shock = 0;
                    features.diagnosis_confidence = 0.0f;
                    
                    dsp_state = DSP_FINISH;
                    break;
                }
                
                /*=========================================
                Todavía no está RUNNING confirmado
                =========================================*/
                
                if(machine_run_state != MACHINE_RUNNING)
                {
                    /*
                    Hay actividad, pero todavía estamos confirmando el arranque.*/
                    dsp_state = DSP_FINISH;
                    break;
                }
                
                /*=========================================
                RUNNING pero sin baseline
                =========================================*/
                
                if(!baseline.valid)
                {
                    update_baseline();
                    
                    dsp_state = DSP_FINISH;
                    break;
                }
                
                /*=========================================
                RUNNING + baseline válido
                =========================================*/
                
                diagnose_machine();
                
                dsp_state = DSP_FINISH;
                break;
            }

            /* Caso Finish */
            case DSP_FINISH:

            telemetry.machine_state = machine_state;
            telemetry.alarm_level = alarm_level;
            telemetry.features = features;
            telemetry.timestamp = features.timestamp;
            
            modbus_update_features(&telemetry);
            
            processing_finished = true;
            proceesing_busy = false;
            dsp_state = DSP_IDLE;
            
            break;
        }

        vTaskDelay(pdMS_TO_TICKS(10));
    }
}

/* Tarea de depuración */
void task_debug(void *pvParameters)
{
    while(1)
    {
        if(processing_finished)
        {
            processing_finished = false;

            printf("\n");
            printf("============================================================\n");
            printf("               SMMR v3.0 - DIAGNOSTIC REPORT\n");
            printf("============================================================\n");


            /*=========================================
              Estado operativo
            =========================================*/

            printf(
                "Operational   : %s\n",
                machine_run_state == MACHINE_RUNNING ?
                "RUNNING" :
                "STOPPED"
            );


            /*=========================================
              Estado del baseline / diagnóstico
            =========================================*/

            if(machine_run_state == MACHINE_STOPPED)
            {
                printf(
                    "Machine State : NOT DIAGNOSED\n"
                );

                printf(
                    "Baseline      : %s\n",
                    baseline.valid ?
                    "VALID" :
                    "NOT AVAILABLE"
                );

                printf(
                    "Alarm Level   : INACTIVE\n"
                );

                printf(
                    "Confidence    : --\n"
                );
            }
            else if(!baseline.valid)
            {
                printf(
                    "Machine State : BASELINE LEARNING\n"
                );

                /*
                   Antes de comenzar la adquisición
                   se ejecutan las ventanas de
                   estabilización.
                */

                if(baseline_stability_counter <
                   BASELINE_STABILIZATION_WINDOWS)
                {
                    printf(
                        "Baseline      : STABILIZING (%u/%u)\n",
                        baseline_stability_counter,
                        BASELINE_STABILIZATION_WINDOWS
                    );
                }
                else
                {
                    printf(
                        "Baseline      : LEARNING (%u/%u)\n",
                        baseline_accumulator.count,
                        BASELINE_WINDOWS
                    );
                }

                printf(
                    "Alarm Level   : INACTIVE\n"
                );

                printf(
                    "Confidence    : --\n"
                );
            }
            else
            {
                printf(
                    "Machine State : %s\n",
                    state_to_string(machine_state)
                );

                printf(
                    "Baseline      : VALID\n"
                );

                printf(
                    "Alarm Level   : %s\n",
                    alarm_to_string(alarm_level)
                );

                printf(
                    "Confidence    : %.1f %%\n",
                    features.diagnosis_confidence
                );
            }


            printf(
                "Timestamp     : %llu us\n",
                features.timestamp
            );


            /*=========================================
              RMS
            =========================================*/

            printf("\n");
            printf("---------------- RMS (m/s²) ----------------\n");

            printf(
                "X: %.5f   Y: %.5f   Z: %.5f\n",
                features.rms[0],
                features.rms[1],
                features.rms[2]
            );


            /*=========================================
              Peak
            =========================================*/

            printf("\n");
            printf("---------------- Peak (m/s²) ---------------\n");

            printf(
                "X: %.5f   Y: %.5f   Z: %.5f\n",
                features.peak[0],
                features.peak[1],
                features.peak[2]
            );


            /*=========================================
              Crest Factor
            =========================================*/

            printf("\n");
            printf("--------------- Crest Factor ---------------\n");

            printf(
                "X: %.2f    Y: %.2f    Z: %.2f\n",
                features.crest[0],
                features.crest[1],
                features.crest[2]
            );


            /*=========================================
              Kurtosis
            =========================================*/

            printf("\n");
            printf("---------------- Kurtosis ------------------\n");

            printf(
                "X: %.2f    Y: %.2f    Z: %.2f\n",
                features.kurtosis[0],
                features.kurtosis[1],
                features.kurtosis[2]
            );


            /*=========================================
              Frecuencia dominante
            =========================================*/

            printf("\n");
            printf("------------ Dominant Frequency ------------\n");

            printf(
                "Axis       : %c\n",
                'X' + features.dominant_axis
            );

            printf(
                "Frequency  : %.2f Hz\n",
                features.dominant_freq
            );

            printf(
                "Amplitude  : %.3f\n",
                features.dominant_amp
            );

            printf(
                "Order      : %.2fX\n",
                features.dominant_order
            );


            /*=========================================
              Order Tracking
            =========================================*/

            printf("\n");
            printf("-------------- Order Tracking --------------\n");

            printf(
                "1X : %.3f\n",
                features.order_amp_1x
            );

            printf(
                "2X : %.3f   (%.2f)\n",
                features.order_amp_2x,
                features.order_ratio_2x_1x
            );

            printf(
                "3X : %.3f   (%.2f)\n",
                features.order_amp_3x,
                features.order_ratio_3x_1x
            );

            printf(
                "4X : %.3f   (%.2f)\n",
                features.order_amp_4x,
                features.order_ratio_4x_1x
            );


            /*=========================================
              FFT Peaks
            =========================================*/

            printf("\n");
            printf("---------------- FFT Peaks -----------------\n");

            for(int axis = 0; axis < 3; axis++)
            {
                printf(
                    "%c : ",
                    'X' + axis
                );

                for(int i = 0;
                    i < FFT_TOP_PEAKS;
                    i++)
                {
                    printf(
                        "[%.2f Hz | %.3f] ",
                        features.fft_freq[axis][i],
                        features.fft_amp[axis][i]
                    );
                }

                printf("\n");
            }


            /*=========================================
              Baseline
            =========================================*/

            printf("\n");
            printf("---------------- Baseline ------------------\n");

            if(baseline.valid)
            {
                printf(
                    "RMS  : X=%.5f Y=%.5f Z=%.5f\n",
                    baseline.rms[0],
                    baseline.rms[1],
                    baseline.rms[2]
                );

                printf(
                    "Peak : X=%.5f Y=%.5f Z=%.5f\n",
                    baseline.peak[0],
                    baseline.peak[1],
                    baseline.peak[2]
                );

                printf(
                    "1X   : %.3f\n",
                    baseline.amp_1x
                );

                printf(
                    "2X   : %.3f\n",
                    baseline.amp_2x
                );

                printf(
                    "3X   : %.3f\n",
                    baseline.amp_3x
                );
            }
            else if(machine_run_state == MACHINE_RUNNING)
            {
                if(baseline_stability_counter <
                   BASELINE_STABILIZATION_WINDOWS)
                {
                    printf(
                        "Status : STABILIZING (%u/%u)\n",
                        baseline_stability_counter,
                        BASELINE_STABILIZATION_WINDOWS
                    );
                }
                else
                {
                    printf(
                        "Status : LEARNING (%u/%u)\n",
                        baseline_accumulator.count,
                        BASELINE_WINDOWS
                    );
                }
            }
            else
            {
                printf(
                    "Status : WAITING FOR MACHINE START\n"
                );
            }


            /*=========================================
              Diagnosis Score
            =========================================*/

            printf("\n");
            printf("------------- Diagnosis Score --------------\n");


            if(machine_run_state == MACHINE_STOPPED)
            {
                printf(
                    "Diagnosis disabled - machine STOPPED\n"
                );
            }
            else if(!baseline.valid)
            {
                printf(
                    "Diagnosis disabled - learning baseline\n"
                );
            }
            else
            {
                printf(
                    "Normal       : %2d\n",
                    features.score_normal
                );

                printf(
                    "Unbalance    : %2d\n",
                    features.score_unbalance
                );

                printf(
                    "Misalignment : %2d\n",
                    features.score_misalignment
                );

                printf(
                    "Looseness    : %2d\n",
                    features.score_looseness
                );

                printf(
                    "Bearing      : %2d\n",
                    features.score_bearing
                );

                printf(
                    "Shock        : %2d\n",
                    features.score_shock
                );
            }


            printf(
                "============================================================\n"
            );
        }


        vTaskDelay(
            pdMS_TO_TICKS(100)
        );
    }
}

/* Aplicación principal */
void app_main(void)
{
    //ESP_LOGI(TAG, "Iniciando SMMR v3.0");

    esp_err_t ret;

    printf("\n");
    printf("=====================================\n");
    printf(" SMMR v3.0\n");
    printf(" Inicializando...\n");
    printf("=====================================\n");

    /* Inicializar BMI160 */
    ret = bmi160_init();

    if(ret != ESP_OK)
    {
        printf("Error inicializando BMI160: %s\n",
               esp_err_to_name(ret));

        while(1)
            vTaskDelay(pdMS_TO_TICKS(1000));
    }

    printf("BMI160 inicializado correctamente.\n");

    /* Calibración */
    calculate_offset();

    printf("Calibración finalizada.\n");

    /* Configuración de máquina */
    load_machine_configuration();

    ret = dsps_fft2r_init_fc32(NULL, FFT_SIZE);
    
    if(ret != ESP_OK)
    {
        printf("Error inicializando FFT\n");
        while(1);
    }
    
    calculate_hann_window();

    xTaskCreatePinnedToCore(
        task_motion,
        "Motion",
        4096,
        NULL,
        5,
        NULL,
        0);

    xTaskCreatePinnedToCore(
        task_processing,
        "Processing",
        4096,
        NULL,
        3,
        NULL,
        1    
    );

    xTaskCreatePinnedToCore(
        task_debug,
        "Debug",
        4096,
        NULL,
        1,
        NULL,
        1);

    printf("Sistema iniciado.\n");
}
