/* Variables de procesamiento */
static float rms_x = 0.0f;
static float rms_y = 0.0f;
static float rms_z = 0.0f;

static float peak_x = 0.0f;
static float peak_y = 0.0f;
static float peak_z = 0.0f;

static float crest_x = 0.0f;
static float crest_y = 0.0f;
static float crest_z = 0.0f;

#define FFT_SIZE WINDOW_SIZE

static float fft_window[FFT_SIZE];

static float fft_buffer_x[2 * FFT_SIZE];
static float fft_buffer_y[2 * FFT_SIZE];
static float fft_buffer_z[2 * FFT_SIZE];

static float fft_mag_x[FFT_SIZE / 2];
static float fft_mag_y[FFT_SIZE / 2];
static float fft_mag_z[FFT_SIZE / 2];

#define FFT_TOP_PEAKS 3
#define MIN_PEAK_DISTANCE 5

static float fft_peak_freq_x[FFT_TOP_PEAKS];
static float fft_peak_amp_x[FFT_TOP_PEAKS];

static float fft_peak_freq_y[FFT_TOP_PEAKS];
static float fft_peak_amp_y[FFT_TOP_PEAKS];

static float fft_peak_freq_z[FFT_TOP_PEAKS];
static float fft_peak_amp_z[FFT_TOP_PEAKS];

static float kurtosis_x = 0.0f;
static float kurtosis_y = 0.0f;
static float kurtosis_z = 0.0f;

